+// A non-editable element is skipped when comparing positions when it
+// is a widget with `relaxedSide`, or when the node or mark view whose
+// `dom` it belongs to declares `ignoreForSelection`.
+function ignoreForSelection(dom: Node) {
+  let desc = dom.pmViewDesc
+  if (desc) return desc.ignoreForSelection
+  for (let cur = dom.parentNode; cur; cur = cur.parentNode) {
+    let parentDesc = cur.pmViewDesc
+    if (parentDesc) return parentDesc.ignoresDOMForSelection(dom)
+  }
+  return false
+}
